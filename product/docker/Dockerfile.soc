FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy backend source and install dependencies
# pyproject.toml has packages.find where=["app"], so we need the app/ dir present
COPY backend/pyproject.toml backend/README.md ./
COPY backend/app/ ./app/

RUN pip install --no-cache-dir -e ".[dev]"

# Copy frontend (main.py resolves FRONTEND_DIR relative to backend dir)
COPY frontend/ /frontend/

# Data directory for SQLite (mounted volume)
RUN mkdir -p /data

EXPOSE 8000

ENV DATABASE_URL=sqlite:///data/bigbrowser.db
ENV HOST=0.0.0.0
ENV PORT=8000

HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD curl -sf http://localhost:8000/health/ || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
